# 复制为 .env 并填写。系统没有演示模式：面试/报告全部依赖真实大模型，
# OPENAI_API_KEY 留空时服务可启动但无法进行面试（页面会提示配置）。
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# 兼容 DeepSeek / Moonshot / 通义 等任何 OpenAI 风格端点，例如：
# OPENAI_BASE_URL=https://api.deepseek.com/v1
# OPENAI_MODEL=deepseek-chat

# 会话与报告的 SQLite 存储路径（相对项目根目录）
DB_PATH=data/interview.db

# 公司背景检索语言（默认 zh，可换 en）
WIKI_LANG=zh

# 可选：全网搜索该公司/岗位面经以定制面试风格（Tavily Search，免费 1000 次/月）
# 申请：https://app.tavily.com  → 留空则跳过面经检索，仅用 JD/Wikipedia 画像
TAVILY_API_KEY=

# 面试最多提问轮数
MAX_TURNS=12
